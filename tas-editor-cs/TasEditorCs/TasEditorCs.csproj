<Project Sdk="Microsoft.NET.Sdk">

    <!-- <snippet:template-shape> -->
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
        <!--
            x64 first so an unqualified `dotnet build` / F5 picks the right default on the
            majority of dev machines. ARM64 second for Snapdragon X. X86 retained for parity
            with the WinUI 3 templates even though Reactor itself is only tested on x64 / ARM64.
        -->
        <Platforms>x64;ARM64;X86</Platforms>
        <UseWinUI>true</UseWinUI>
        <WindowsPackageType>None</WindowsPackageType>
        <!--
            WindowsAppSDKSelfContained bundles the Windows App SDK runtime alongside the
            published exe so the app:
              (a) runs from any folder without a separate Windows App Runtime install, and
              (b) survives `dotnet watch run` hot reload (used by the Reactor Visual Studio
                  embedded-preview extension — spec 056). Incremental rebuilds otherwise
                  double-count transitive Microsoft.WindowsAppSDK.* references and trip
                  Microsoft.WindowsAppSDK.ComponentReference.targets' strict version check
                  ("version 2.0.20;2.0.20 was referenced"). Self-contained bundling
                  sidesteps that check.
            Tradeoff: ~30 MB extra in the publish output. To ship framework-dependent
            (smaller publish, requires the user to install Microsoft.WindowsAppRuntime
            separately) flip this to false and ensure your install instructions tell users
            to install the runtime first.
        -->
        <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
        <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
        <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
        <Nullable>enable</Nullable>
        <!--
            Embeds the app icon in the .exe so File Explorer and shortcuts show it.
            The ReactorApp.Run(icon:) call in App.cs sets the *window* icon (taskbar /
            Alt-Tab / Task Manager); without either, Reactor falls back to
            Assets\AppIcon.ico and then to this embedded icon.
        -->
        <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
        <!--
            Auto-resolve RuntimeIdentifier from the host SDK when the caller hasn't pinned
            Platform / RuntimeIdentifier explicitly. Lets `dotnet build` / `dotnet run`
            succeed without forcing -p:Platform=x64 on every invocation — WindowsAppSDK's
            self-contained build path requires a concrete RID.
        -->
        <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' And ('$(Platform)' == '' Or '$(Platform)' == 'AnyCPU' Or '$(Platform)' == 'Any CPU')">$(NETCoreSdkPortableRuntimeIdentifier)</RuntimeIdentifier>
        <!--
            `[LibraryImport]` (the Win32 window activation in GameWindow.cs) generates marshalling
            code that the compiler accepts only as unsafe, so this flag is what lets the source
            generator's own output build. There is no hand-written unsafe code in the project.
        -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!--
            Globalization mode, not a code-generation switch: it does not touch the
            metadata updater, so it is safe for every configuration — and Debug then
            behaves like the shipped build instead of quietly differing in culture
            handling. The template pairs it with AOT below.
        -->
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>
    <!-- </snippet:template-shape> -->

    <!--
        NativeAOT, Release only. The publish output is a native x64 exe that carries no .NET
        runtime dependency; together with WindowsAppSDKSelfContained above, the whole app is
        xcopy-deployable.
        The template's AOT switch sets PublishAot unconditionally. Measured 2026-09-21,
        that leaks the AOT feature switches into ordinary Debug builds: the Debug
        runtimeconfig then carries
        `"System.Reflection.Metadata.MetadataUpdater.IsSupported": false`, which kills hot
        reload — `dotnet watch run` and the reload supervision inside `mur devtools` have no
        migration subsystem left to use.
        The cost of gating it on Release: the trim/AOT analyzers no longer run in the Debug
        dev loop, so they need a Release build before shipping instead of never — the exact
        command is in the Verification section of `QWEN.md`.
    -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <PublishAot>true</PublishAot>
    </PropertyGroup>

    <!--
        Publish the XAML compiler's merged app resource index ($(TargetName).pri, written
        next to the exe by the Windows App SDK's MrtCore.PriGen targets).
        It never reaches the publish output on its own: the SDK feeds @(ProjectPriFile) to
        its own MSIX packaging pipeline only, and a plain unpackaged publish computes its
        file list from the project output groups, which do not carry it. Without this file
        the published app starts and dies with a stowed exception (0xC000027B) inside XAML
        before the first frame — the merged WinUI control resources are missing. Verified
        against the stock scaffold from `dotnet new reactorapp`, so it is not something
        the template or the debug loop would have caught.
    -->
    <Target Name="_PublishAppPri"
            AfterTargets="ComputeResolvedFilesToPublishList"
            BeforeTargets="CopyFilesToPublishDirectory">
        <ItemGroup>
            <ResolvedFileToPublish Include="$(TargetDir)$(TargetName).pri"
                                    Condition="Exists('$(TargetDir)$(TargetName).pri')">
                <RelativePath>$(TargetName).pri</RelativePath>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            </ResolvedFileToPublish>
        </ItemGroup>
    </Target>

    <!--
        The mod payload: the installer writes these two files into the game, and the editor
        carries them inside its own exe as embedded resources. Sources, and why they are not
        committed, are in `build-mod.ps1`:
          Mod\drmod_rs_lib.asi — the cargo release build of the mod, renamed;
          Mod\d3d9.dll         — the vendored Ultimate-ASI-Loader (Win32).
    -->
    <ItemGroup>
        <EmbeddedResource Include="Mod\drmod_rs_lib.asi" LogicalName="Mod.drmod_rs_lib.asi" />
        <EmbeddedResource Include="Mod\d3d9.dll" LogicalName="Mod.d3d9.dll" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
        <!--
            Example scripts ship next to the exe so a fresh install has something to open:
            the editor starts on an empty folder, and the `Open folder…` picker would
            otherwise have nothing to point at.

            These are copies, not links to the repo's tools/demo/: the editor is meant to be
            self-contained (its own workspace, its own build), and a `Link` into a Rust tool
            directory would break the moment this folder is built on its own.

            `r03_tas.tas` is the first R-03 segment's real TAS; `stress.tas` is the same
            aiming loop swept around the compass (3482 frames), which is what the command
            table's scrolling and the text region's live parse get exercised against.
        -->
        <Content Include="examples\*.tas" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <!--
            The components and the script model stay internal — a public surface that only
            the tests would ever call is not worth having. The test assembly gets a window
            into the app instead.
        -->
        <InternalsVisibleTo Include="TasEditorCs.Tests" />
    </ItemGroup>

    <!--
        The payload is not in version control, so a fresh clone has none and `dotnet build` would
        otherwise succeed with an exe whose Install button cannot install anything — a defect that
        only shows up in front of the game, with the user watching. Fail the build instead, naming
        the command that fixes it.
        Skipped for the test project's own builds? No: the resources live in this project, and a
        test run builds it too, so the check has to hold there as well (`build-mod.ps1` stages the
        payload once and both then use it).
    -->
    <Target Name="_RequireModPayload" BeforeTargets="BeforeBuild">
        <Error Condition="!Exists('Mod\drmod_rs_lib.asi') OR !Exists('Mod\d3d9.dll')"
               Text="The mod payload is missing (TasEditorCs\Mod\drmod_rs_lib.asi, d3d9.dll). Build it first: pwsh -File build-mod.ps1" />
    </Target>

    <ItemGroup>
        <PackageReference Include="Microsoft.UI.Reactor" Version="0.1.0-preview.15" />
        <!--
            Docking (DockManager / DockSplit and its drag-resize splitters) ships in the
            Advanced package, not in the base one. It is the one place the packaging guide
            warns about: Advanced roots its WinRT activation chain for the AOT trimmer, and
            it drags in Win2D (~1 MB managed + ~3 MB native interop) even though docking
            does not need it. Take that trade knowingly — the window shell is built on it.
        -->
        <PackageReference Include="Microsoft.UI.Reactor.Advanced" Version="0.1.0-preview.15" />
        <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    </ItemGroup>

    <!--
        Debug-only: enable the Reactor devtools surface so the *devtools* flag
        (from Properties/launchSettings.json's default F5 args) lights up the
        devtools menu, and so the Visual Studio embedded-preview extension's
        embed-host activation (which requires devtools support) succeeds.
        Release / Publish builds drop both the package and the host-config
        switch so the trim / AOT analyzers stay happy (see
        docs/guide/packaging.md, section "Keep Reactor.DevtoolsSupport out of
        retail"). To enable devtools in Release as well, move these into the
        unconditioned ItemGroup above.
    -->
    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <PackageReference Include="Microsoft.UI.Reactor.Devtools" Version="0.1.0-preview.15" />
        <RuntimeHostConfigurationOption Include="Reactor.DevtoolsSupport" Value="true" Trim="true" />
    </ItemGroup>

</Project>
