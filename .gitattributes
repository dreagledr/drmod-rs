# Rust sources are stored and checked out with LF: rustfmt's `newline_style` then has
# nothing to normalize, and `cargo fmt --check` is stable across checkouts on any OS.
# `drmod-hudhook` already declares this for its own files (vendored fork).
*.rs text eol=lf

# Git hooks are executed by sh; a CRLF shebang line makes them unrunnable on Windows.
.githooks/** text eol=lf
