alloc(newmem,$1000)
label(code)
label(return)

newmem:
  cmp byte ptr ["METAL GEAR RISING REVENGEANCE.exe"+19D05F4],40
  je grounded
  jmp code

grounded:
  mov [eax],2
  jmp return

code:
  mov [eax],00000000
  jmp return

EnemyStep:
  jmp newmem
  nop
return:
registersymbol(EnemyStep)

