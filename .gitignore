/target
/tools/disasm/target
/drmod-tas-editor/target
# xtask is its own workspace root (see xtask/Cargo.toml), so it gets a target/ of its own
/xtask/target
# Раскладка докспейса редактора: рабочий файл ImGui, перезаписывается на каждом запуске
/drmod-tas-editor/drmod-tas-editor-layout.ini
# Mod payload the editor installs: staged by build.rs into OUT_DIR, not committed
/drmod-tas-editor/Mod/
/drmod-tas-editor/*.log
/tas-editor-cs/**/bin
/tas-editor-cs/**/obj
/tas-editor-cs/**/publish
/tas-editor-cs/out
/tas-editor-cs/dist
/tas-editor-cs/*.zip
# Mod payload the editor embeds: produced by tas-editor-cs/build-mod.ps1
/tas-editor-cs/TasEditorCs/Mod/
# JetBrains Rider: local IDE state, not project files
/tas-editor-cs/.idea/
/tas-editor-cs/*.DotSettings.user
/out
.env
.qwen/
# Отладочные логи верификации входов (перегенерируются тест-скриптами)
test_inputs/logs_*.json
# Python-тулы в tools/ (script_tuning, desync_analysis)
__pycache__/
"tools/script_tuning/out/"  
